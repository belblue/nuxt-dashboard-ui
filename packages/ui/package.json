        "components",
        "accessible",
        "ssr",
        "dark-mode"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/belenacin/nuxt-dashboard-ui"
    },
    "homepage": "https://github.com/belenacin/nuxt-dashboard-ui#readme",
    "bugs": {
        "url": "https://github.com/belenacin/nuxt-dashboard-ui/issues"
    },
    "exports": {
