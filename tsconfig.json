{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": ["packages/ui/src"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/.nuxt",
    "**/.output",
    "**/*.test.ts"
  ]
}
